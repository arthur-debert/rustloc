{#-
  The count table.

  Context (from `crate::table::CountView`):
    aggregation  "total" | "crate" | "module" | "file"
    columns      enabled column keys, in display order
    rows         [{label, values: [{raw, display}, ...]}] values follow `columns`
    total        [{raw, display}, ...]              the totals row's values
    footer       {displayed, displayed_display, total_items,
                  total_items_display, file_count, file_count_display,
                  top_applied}
    ratios       optional [{whole, fraction, formatted}, ...]

  Count cell display strings may be plain or locale-grouped. When ratios are
  enabled, the `%` suffix takes one display column, so the value columns reserve
  that suffix column on every numeric row and the numeric part still aligns with
  the integer counts.
-#}
{%- import "table_macros" as t -%}

{#- Per column: the header word, and a width wide enough for that word and for
    every value beneath it (rows *and* the totals row). Taking the totals row
    into account is what keeps the total from ever having fewer digits than a
    row above it. -#}
{%- set ns = namespace(headers=[], widths=[]) -%}
{%- for key in columns -%}
  {%- set i = loop.index0 -%}
  {%- set header = t.COLUMN_HEADERS[key] -%}
  {%- set w = namespace(max = header | length) -%}
  {%- for row in rows -%}
    {%- set w.max = [w.max, row.values[i].display | length] | max -%}
  {%- endfor -%}
  {%- set w.max = [w.max, total[i].display | length] | max -%}
  {%- if ratios -%}
    {%- set ratio = ratios[i] -%}
    {%- set w.max = [w.max, ((ratio.whole | string) | length) + 3] | max -%}
  {%- endif -%}
  {%- set ns.headers = (ns.headers + [header]) | list -%}
  {%- set ns.widths = (ns.widths + [w.max]) | list -%}
{%- endfor -%}
{{ t.table(aggregation, ns.headers, rows, total, footer, ns.widths, ratios) }}
{# The table must end in a newline, and MiniJinja strips a single trailing
   newline at end of template — so this comment, not the table, is what sits at
   EOF and absorbs the strip. Deleting it silently un-terminates the last line. #}
