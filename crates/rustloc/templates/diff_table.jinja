{#-
  The diff table.

  Context (from `crate::table::DiffView`):
    aggregation  "total" | "crate" | "module" | "file" | "commit"
    columns      enabled column keys, in display order
    rows         [{label, change_type?, values:
                  [{added: {raw, display}, removed: {raw, display},
                    net: {raw, display}}, ...]}]
                 change_type is Added/Deleted/Modified on `--by-file` rows only
    total        [{added: {raw, display}, removed: {raw, display},
                   net: {raw, display}}, ...]      the totals row's values
    footer       {displayed, displayed_display, total_items,
                  total_items_display, file_count, file_count_display,
                  top_applied}
    from_commit  / to_commit
    non_rust     {added: {raw, display}, removed: {raw, display},
                  net: {raw, display}} for files the language selection skipped
    net_only     true when `--net-only` asked for the signed net alone
    unmatched_globs  the `-i`/`-e` globs, as written, that matched no change

  Everything a diff shows beyond the shared table skeleton lives here: the
  title, the `+added/-removed/net` notation, the skipped-changes summary, and
  the legend that explains the notation.

  `net_only` reaches here as a bare request; the three places a reader would
  notice it — the cell, the skipped-changes summary, and the legend — each
  answer it below, because Rust ships every cell's added, removed, and net
  numbers either way.
-#}
{%- import "table_macros" as t -%}

{#- A net change, coloured by its sign: the additions tag for a gain, the
    deletions tag for a loss, and no tag at all for zero — which leaves it the
    surrounding text colour, so an unchanged row reads as neutral rather than as
    a very small edit.

    The `raw` number decides, not `display`: digit grouping and the minus sign a
    reader sees are formatting, and a `-0` or a grouped `-1,000` must not talk
    the tag out of matching the arithmetic. Only `net_only` cells and the
    skipped-changes net use this; the full `+added/-removed/net` notation tags
    its two counts instead. -#}
{%- macro signed_net(net) -%}
{%- if net.raw > 0 -%}[additions]{{ net.display }}[/additions]
{%- elif net.raw < 0 -%}[deletions]{{ net.display }}[/deletions]
{%- else -%}{{ net.display }}
{%- endif -%}
{%- endmacro -%}

{#- One diff cell: `+added/-removed/net`, each sub-field right-aligned to its
    column's sub-width so the `/` separators line up down the whole column.

    The padding sits *outside* the style tags on purpose: colour belongs on the
    digits, not on the whitespace that positions them.

    Under `net_only` the cell is the net sub-field alone, right-aligned to the
    same sub-width the full notation would give it — so a net reads identically
    in both modes and only its neighbours disappear. There it is also the only
    number in the cell, so `signed_net` colours it by its sign; in the full
    notation the net stays untagged, because `[additions]`/`[deletions]` already
    mark the `+N`/`-N` counts beside it. -#}
{%- macro diff_cell(v, sub, net_only) -%}
{%- if net_only -%}
{{ " " * (sub.net - (v.net.display | length)) }}{{ signed_net(v.net) }}
{%- else -%}
{{ " " * (sub.added - (("+" ~ v.added.display) | length)) }}[additions]+{{ v.added.display }}[/additions]/{{ " " * (sub.removed - (("-" ~ v.removed.display) | length)) }}[deletions]-{{ v.removed.display }}[/deletions]/{{ " " * (sub.net - (v.net.display | length)) }}{{ v.net.display }}
{%- endif -%}
{%- endmacro -%}

{#- Per column: the header word, the three sub-widths, and the column width.

    Sub-widths are the max of each sub-field across every row *and* the totals
    row — the totals row usually wins, since it sums the rows. Computing them
    across the whole column (rather than per row) is what makes the separators
    align vertically.

    The column is as wide as its header word or as the notation needs
    (`+added` + `/` + `-removed` + `/` + `net`), whichever is greater — and
    under `net_only`, as wide as its header word or the net sub-field alone, so
    dropping the two counts narrows the table rather than leaving their space
    blank. -#}
{%- set ns = namespace(headers=[], widths=[], subs=[]) -%}
{%- for key in columns -%}
  {%- set i = loop.index0 -%}
  {%- set header = t.COLUMN_HEADERS[key] -%}
  {%- set s = namespace(added=0, removed=0, net=0) -%}
  {%- for row in (rows + [{"values": total}]) -%}
    {%- set v = row.values[i] -%}
    {%- set s.added = [s.added, ("+" ~ v.added.display) | length] | max -%}
    {%- set s.removed = [s.removed, ("-" ~ v.removed.display) | length] | max -%}
    {%- set s.net = [s.net, v.net.display | length] | max -%}
  {%- endfor -%}
  {%- set ns.subs = (ns.subs + [{"added": s.added, "removed": s.removed, "net": s.net}]) | list -%}
  {%- set ns.headers = (ns.headers + [header]) | list -%}
  {%- set value_width = s.net if net_only else (s.added + s.removed + s.net + 2) -%}
  {%- set ns.widths = (ns.widths + [[header | length, value_width] | max]) | list -%}
{%- endfor -%}

{#- Render every cell against its column's sub-widths. -#}
{%- set body = namespace(rows=[], total=[]) -%}
{%- for row in rows -%}
  {%- set cells = namespace(list=[]) -%}
  {%- for v in row.values -%}
    {%- set cells.list = (cells.list + [{"display": diff_cell(v, ns.subs[loop.index0], net_only)}]) | list -%}
  {%- endfor -%}
  {%- set body.rows = (body.rows + [{"label": row.label, "change_type": row.change_type, "values": cells.list}]) | list -%}
{%- endfor -%}
{%- for v in total -%}
  {%- set body.total = (body.total + [{"display": diff_cell(v, ns.subs[loop.index0], net_only)}]) | list -%}
{%- endfor -%}
{# Output starts below. Every tag above trims its own whitespace away, so the
   newline after this comment is the first thing emitted — it is the blank line
   that sets the title off from the prompt, not an accident. #}
Diff: {{ from_commit }} → {{ to_commit }}

{{ t.table(aggregation, ns.headers, body.rows, body.total, footer, ns.widths) }}
{% if non_rust.added.raw > 0 or non_rust.removed.raw > 0 %}

Skipped changes: {% if net_only %}{{ signed_net(non_rust.net) }} net{% else %}[additions]+{{ non_rust.added.display }}[/additions] / [deletions]-{{ non_rust.removed.display }}[/deletions] / {{ non_rust.net.display }} net{% endif %}
{% endif %}
[muted]({% if net_only %}net{% else %}+added / -removed / net{% endif %})[/muted]{{ t.glob_warnings(unmatched_globs, "changed file", "repository root") }}
{# The legend must end in a newline, and MiniJinja strips a single trailing
   newline at end of template — so this comment, not the legend, is what sits at
   EOF and absorbs the strip. Deleting it silently un-terminates the last line. #}
